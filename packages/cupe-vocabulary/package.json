{
  "name": "@nzila/cupe-vocabulary",
  "version": "0.1.0",
  "description": "CUPE union vocabulary and taxonomy system for Union Eyes pilot",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
