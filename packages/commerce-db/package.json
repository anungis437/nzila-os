{
  "name": "@nzila/commerce-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./customers": "./src/repositories/customers.ts",
    "./quotes": "./src/repositories/quotes.ts",
    "./orders": "./src/repositories/orders.ts",
    "./invoices": "./src/repositories/invoices.ts",
    "./fulfillment": "./src/repositories/fulfillment.ts",
    "./payments": "./src/repositories/payments.ts",
    "./opportunities": "./src/repositories/opportunities.ts",
    "./disputes": "./src/repositories/disputes.ts",
    "./evidence": "./src/repositories/evidence.ts",
    "./sync": "./src/repositories/sync.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nzila/commerce-core": "workspace:*",
    "@nzila/db": "workspace:*",
    "@nzila/org": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "typescript": "^6",
    "vitest": "^4.1.7",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10"
  }
}
