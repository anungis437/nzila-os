{
  "name": "@nzila/governance-otel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenTelemetry adapter that maps governance event envelopes to OTel spans with semantic governance attributes.",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./adapter": "./src/adapter.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": { "vitest": "^5.0.5" }
}
