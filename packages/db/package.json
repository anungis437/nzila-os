{
  "name": "@nzila/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./raw": "./src/raw.ts",
    "./scoped": "./src/scoped.ts",
    "./audit": "./src/audit.ts",
    "./platform": "./src/platform.ts",
    "./org-registry": "./src/org-registry.ts",
    "./queries/trustcore": "./src/queries/trustcore.ts",
    "./eslint-no-shadow-db": "./eslint-no-shadow-db.mjs"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nzila/platform-data-fabric": "workspace:*",
    "@nzila/platform-decision-graph": "workspace:*",
    "@nzila/platform-event-fabric": "workspace:*",
    "@nzila/platform-governed-ai": "workspace:*",
    "@nzila/platform-knowledge-registry": "workspace:*",
    "@nzila/platform-ontology": "workspace:*",
    "@nzila/platform-reasoning-engine": "workspace:*",
    "@nzila/platform-semantic-search": "workspace:*",
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "typescript": "^6",
    "vitest": "^4.1.5"
  }
}
