{
  "name": "@nzila/workload-intelligence",
  "version": "0.1.0",
  "description": "Workload Intelligence Layer (WIL) — decision prioritization across competing workloads, built on NIL",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./models": "./src/models/types.ts",
    "./signals": "./src/signals/index.ts",
    "./scoring": "./src/scoring/priorityScore.ts",
    "./engine": "./src/engine/prioritizationEngine.ts",
    "./explanations": "./src/explanations/generateExplanation.ts",
    "./orchestration": "./src/orchestration/workloadOrchestrator.ts",
    "./contracts": "./src/contracts/ui.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nzila/intelligence": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
