{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nzilaos://treasurer/investment-thesis-register.schema.json",
  "title": "INVESTMENT_THESIS_REGISTER_SCHEMA",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "epistemicClass", "statement", "sourceIds", "contentHash", "priorHash"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "epistemicClass": { "const": "THESIS" },
    "statement": { "type": "string" },
    "sourceIds": { "type": "array", "minItems": 1 },
    "contentHash": { "type": "string" },
    "priorHash": { "type": ["string", "null"] }
  }
}
