{
  "name": "@nzila/maestria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3021",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "assets:screenshots": "node scripts/generate-screenshot-assets.mjs",
    "onboarding:readiness": "node -e \"fetch('http://localhost:3021/api/maestria/onboarding/readiness?as=lissa').then(r=>r.text()).then(t=>console.log(t))\"",
    "db:backup": "node --import tsx/esm scripts/db-backup.mjs",
    "db:restore": "node --import tsx/esm scripts/db-restore.mjs"
  },
  "dependencies": {
    "@nzila/flow-engine": "workspace:*",
    "@nzila/os-core": "workspace:*",
    "@nzila/platform-auth": "workspace:*",
    "@types/pdfkit": "^0.17.6",
    "next": "16.2.12",
    "next-intl": "^4.9.1",
    "pdfkit": "^0.15.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@nzila/config": "workspace:*",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.2.2",
    "typescript": "^6",
    "vitest": "^4.1.2"
  }
}