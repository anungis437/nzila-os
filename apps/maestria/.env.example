# Maestria — Environment Variables
# Copy this file to .env.local and fill in the values.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Absolute path to the SQLite database file.
# Example: /data/maestria.db (production) or ./maestria.db (local dev)
MAESTRIA_DB_PATH=./maestria.db

# Directory where database backups are stored.
# Example: /data/backups (production) or ./backups (local dev)
MAESTRIA_BACKUP_DIR=./backups

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Base URL used for OAuth redirect URIs and absolute URL generation.
# Default: http://localhost:3021
MAESTRIA_BASE_URL=http://localhost:3021

# ---------------------------------------------------------------------------
# Contact Form
# ---------------------------------------------------------------------------

# Email address that receives contact form submissions.
# Default: ops@shopmoica.com
MAESTRIA_CONTACT_INBOX=ops@shopmoica.com

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------

# Maximum number of requests allowed per window. Default: 120
RATE_LIMIT_MAX=120

# Rate limit window in milliseconds. Default: 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Auth (@nzila/platform-auth)
# See packages/platform-auth for full documentation.
# ---------------------------------------------------------------------------

# Secret used to sign session tokens (min 32 chars).
AUTH_SECRET=

# Azure Entra ID (optional — required only if SSO is enabled)
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
