{
  "extends": "../../packages/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "paths": {
      "@/*": ["./*"],
      "@nzila/flow-engine": ["../../packages/flow-engine/src"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".turbo", "dist"]
}