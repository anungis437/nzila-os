# Environment variables for @nzila/cfo
# Copy to .env.local and fill in values

# Auth — Entra External ID / NextAuth
AUTH_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ── Plaid (Open Banking) ────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=

# ── Dext (Receipt / Invoice OCR) ────────────────────────────────────────────
DEXT_API_KEY=
DEXT_BASE_URL=https://api.dext.com/v1

# ── Document Intelligence (Azure / AWS / GCP) ───────────────────────────────
DOC_INTEL_PROVIDER=azure
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
# AWS_REGION=
# GOOGLE_PROJECT_ID=
DOC_INTEL_CONFIDENCE_THRESHOLD=0.8

# ── Xero (Accounting) ───────────────────────────────────────────────────────
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=

# ── Sage (Accounting) ───────────────────────────────────────────────────────
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=

# ── Payroll Provider (ADP / Ceridian / Gusto) ───────────────────────────────
PAYROLL_PROVIDER=ceridian
PAYROLL_CLIENT_ID=
PAYROLL_CLIENT_SECRET=
PAYROLL_BASE_URL=
PAYROLL_API_KEY=

# ── Expense Management (Expensify / Concur) ─────────────────────────────────
EXPENSE_PROVIDER=expensify
EXPENSE_API_KEY=
EXPENSE_API_SECRET=
EXPENSE_BASE_URL=

# ── Business Intelligence (Power BI / Tableau / Metabase) ───────────────────
BI_PROVIDER=powerbi
BI_ENDPOINT=
BI_API_KEY=
BI_CLIENT_ID=
BI_CLIENT_SECRET=
BI_WORKSPACE_ID=
BI_DATASET_ID=

# ── CRM (HubSpot) ───────────────────────────────────────────────────────────
HUBSPOT_API_KEY=

# ── ChatOps (Slack & Teams) ─────────────────────────────────────────────────
SLACK_TOKEN=
SLACK_CHANNEL=#cfo-alerts
TEAMS_WEBHOOK_URL=
TEAMS_CHANNEL=CFO Alerts

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=cfo@example.com

# ── AI / ML ─────────────────────────────────────────────────────────────────
AI_CORE_URL=
AI_API_KEY=
ML_CORE_URL=
ML_API_KEY=

# ── SharePoint (M365) ───────────────────────────────────────────────────────
SHAREPOINT_SITE_ID=

# ── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ── App URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.ledgeriq.io

# ── Build Info ──────────────────────────────────────────────────────────────
BUILD_TIMESTAMP=

# ── E2E Testing ─────────────────────────────────────────────────────────────
CFO_URL=http://localhost:3008
