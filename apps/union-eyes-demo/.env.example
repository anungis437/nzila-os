# @nzila/union-eyes-demo — .env.example
#
# The demo app is a fixture-backed, separately-built artifact. It ships demo
# pages and fixture data with fixture-backed API handlers only — no live
# production integrations. Runtime is gated by `@nzila/reality-env`, which
# enforces demo-mode invariants at boot.
#
# See:
#   docs/union-eyes/reality-remediation/20_SEMANTIC_ISOLATION.md
#   apps/union-eyes/.env.example                       (operational app)
#   packages/reality-env/README.md                     (gating contract)

# ── Runtime identity ───────────────────────────────────────────────
# Reality-env enforces a demo posture: `NZILA_APP_MODE=demo` disables all
# live-tenant code paths and forces fixture-backed data providers.
NZILA_APP_MODE=demo
NEXT_PUBLIC_APP_MODE=demo
NODE_ENV=development

# ── Next.js ────────────────────────────────────────────────────────
# The demo app runs on port 3012 by convention (see package.json scripts).
PORT=3012
NEXT_PUBLIC_APP_URL=http://localhost:3012

# ── Auth — @nzila/platform-auth ────────────────────────────────────
# The demo app uses fixture-backed persona login; Entra SSO is optional
# and disabled by default in demo mode. AUTH_SECRET is still required to
# sign session cookies for the persona picker.
AUTH_SECRET=

# Optional Entra SSO (leave blank for fixture-persona login only)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ── Observability ──────────────────────────────────────────────────
# Sentry is opt-in in demo mode. Leave blank to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=demo

# ── Feature flags ──────────────────────────────────────────────────
# The demo app never talks to live production data. These flags are
# retained for parity with the operational .env.example but must remain
# false; reality-env will refuse to boot with any of them set to true.
FEATURE_LIVE_DATA=false
FEATURE_LIVE_PAYMENTS=false
