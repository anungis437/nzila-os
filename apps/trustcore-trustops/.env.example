# @nzila/trustcore-trustops-app — environment template
# Copy to .env.local and fill in values for local development.

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=trustcore-trustops
PORT=3018

# --- Database (shared @nzila/db) ---
DATABASE_URL=postgresql://nzila:nzila_dev@localhost:5433/nzila_automation

# --- Auth (@nzila/platform-auth) ---
AUTH_SECRET=change-me-in-local
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Feature flags ---
# When NODE_ENV !== 'production', the mandates store falls back to fixtures
# if the database returns empty. No flag needed.
