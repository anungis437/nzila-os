# Nzila Vertical App - Environment Configuration

# Application
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Django
DJANGO_SECRET_KEY=change-me-in-development
SECURE_SSL_REDIRECT=False

# Database
PGDATABASE={{project_name}}_dev
PGUSER=nzilaadmin
PGPASSWORD=dev-password
PGHOST=localhost
PGPORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — Entra External ID (OIDC)
AUTH_JWKS_URL=https://login.microsoftonline.com/common/discovery/v2.0/keys
AUTH_SECRET=
AUTH_WEBHOOK_SECRET=

# API
NEXT_PUBLIC_API_URL=http://localhost:8000
