{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nzila.dev/union-eyes/schema-authority/runtime-required-contract.schema.json",
  "title": "Union Eyes Runtime-Required Physical Contract",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer" },
    "generatedBy": { "type": "string" },
    "doctrine": { "type": "object" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema", "table", "column", "owner", "requirement", "usage", "access"],
        "properties": {
          "schema": { "type": "string", "minLength": 1 },
          "table": { "type": "string", "minLength": 1 },
          "column": { "type": "string", "minLength": 1 },
          "owner": {
            "type": "string",
            "enum": ["DJANGO_CANONICAL", "DRIZZLE_SCOPED", "PLATFORM_AUTH", "EXTERNAL_READONLY"]
          },
          "requirement": { "type": "string", "enum": ["REQUIRED_NOW"] },
          "usage": {
            "type": "string",
            "enum": ["DIRECTLY_CONSUMED", "AUTHORITY_SEMANTIC", "WRITE_REQUIRED", "FILTER_REQUIRED", "JOIN_REQUIRED", "ORDER_REQUIRED"]
          },
          "access": { "type": "string", "enum": ["READ", "WRITE"] },
          "requiredType": { "type": "string" },
          "wave1_acceptance_ids": { "type": "array", "items": { "type": "string" } },
          "source_paths": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
