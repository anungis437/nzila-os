{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nzila.dev/union-eyes/schema-authority/registry.schema.json",
  "title": "Union Eyes Schema Authority Registry",
  "type": "object",
  "required": ["version", "tables", "computed"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer" },
    "generatedBy": { "type": "string" },
    "doctrine": { "type": "object" },
    "ownerKinds": { "type": "object" },
    "invariants": { "type": "object" },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table", "owner"],
        "properties": {
          "table": { "type": "string", "minLength": 1 },
          "owner": {
            "type": "string",
            "enum": ["DJANGO_CANONICAL", "DRIZZLE_SCOPED", "PLATFORM_AUTH", "EXTERNAL_READONLY"]
          },
          "djangoApp": { "type": ["string", "null"] },
          "djangoModel": { "type": ["string", "null"] },
          "evidence": { "type": "string" },
          "runtimeAccess": { "type": "string" },
          "rlsRequired": { "type": "boolean" },
          "canonical43": { "type": "boolean" },
          "reconciliation": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "computed": {
      "type": "object",
      "required": ["UNOWNED_REQUIRED_TABLES", "DUAL_OWNED_REQUIRED_TABLES"],
      "properties": {
        "UNOWNED_REQUIRED_TABLES": { "type": "integer" },
        "DUAL_OWNED_REQUIRED_TABLES": { "type": "integer" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
