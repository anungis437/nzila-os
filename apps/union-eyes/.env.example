# Union Eyes environment template.
# GENERATED from lib/config/env-registry.ts by `pnpm census:env --write-example`. Edit the registry, never this file: `pnpm census:env` fails when they differ.
# One comment line per variable: [when it is required | what kind] what it is for.
#   production = every deployed environment   staging = staging and pilot only, never production   optional = a feature or a tuning knob
#   dev-only = local development only (shown commented out on purpose: copying this file into a deployment must not switch it on)
# Secrets are left empty. A value generated with `openssl rand -hex 32` suits any key the comment does not describe otherwise.

# ── Runtime identity and deployment ─────────────────────────────────────────────────────────────────
# [production | config] Next.js build/runtime mode; every deployed container runs production.
NODE_ENV=development
# [production | config] Canonical deployment identity: local, dev, staging, pilot or production. The escape-hatch guards and the site topology read it.
UE_ENVIRONMENT=development
# [production | config] Public (client-visible, build-time) mirror of UE_ENVIRONMENT.
NEXT_PUBLIC_APP_ENV=development
# [optional | config] Deployment type: pilot, staging or prod.
UE_DEPLOYMENT_TYPE=
# [optional | config] Server runtime profile: internal or executive. A demo profile is refused at boot.
UE_FEATURE_PROFILE=
# [optional | config] Platform mode: pilot, staging or production. Only pilot opens the pilot routes.
NZILA_MODE=
# [optional | config] Platform environment label read by the idempotency store of @nzila/os-core.
NZILA_ENV=
# [optional | config] Legacy alias of UE_DEPLOYMENT_TYPE.
NZILA_DEPLOYMENT_TYPE=
# [optional | config] Environment class stamped on governance telemetry.
NZILA_ENVIRONMENT_CLASS=
# [optional | config] Release id stamped on governance telemetry.
NZILA_RELEASE_ID=
# [optional | config] Policy engine version label.
NZILA_POLICY_VERSION=v1
# [optional | config] Additional deployment-identity signal read by the auth package and the NAR storage selector.
DEPLOYMENT_ENVIRONMENT=
# [optional | config] Target environment the demo-deployment guard and the staging proof judge against.
TARGET_ENVIRONMENT=
# [optional | config] Must stay unset: a demo profile is refused at boot (lib/reality/demo-deployment-guard.ts).
NEXT_PUBLIC_UE_DEMO_PROFILE=
# [optional | config] Must stay unset in this package; only the separate demo package reads a demo profile.
UE_DEMO_PROFILE=
# [optional | config] Must stay unset in this package; the demo organization belongs to the demo package.
UE_DEMO_ORG_ID=
# [optional | config] Must stay unset in this package; the demo organization slug belongs to the demo package.
NEXT_PUBLIC_UE_DEMO_ORG_SLUG=
# [optional | config] Public mirror of UE_FEATURE_PROFILE. Set by the deployment; no code reads it.
NEXT_PUBLIC_UE_FEATURE_PROFILE=
# [optional | flag] Switches the canonical V2 authority bootstrap on (1) or the legacy path (0 or unset).
UE_CANONICAL_BOOTSTRAP_V2=
# [optional | flag] true makes a missing runtime contract refuse the boot instead of logging it.
RUNTIME_FAIL_CLOSED=
# [optional | config] Lineage label: where the secrets come from.
SECRET_TOPOLOGY=
# [optional | config] Lineage label: who owns the secrets.
SECRET_AUTHORITY=
# [optional | config] Lineage label: how this environment is isolated.
ENVIRONMENT_ISOLATION=

# ── Public URLs and site topology ───────────────────────────────────────────────────────────────────
# [production | config] Public URL of the application (build-time, client-visible). Production: https://app.unioneyes.app.
NEXT_PUBLIC_APP_URL=http://localhost:3002
# [optional | config] Public URL of the marketing site, used for canonical URLs, metadata and the sitemap. Production: https://unioneyes.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# [optional | config] Production app URL, when it differs from NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_APP_URL_PRODUCTION=
# [optional | config] Staging app URL.
NEXT_PUBLIC_APP_URL_STAGING=https://staging-app.unioneyes.app
# [optional | config] Production marketing URL, when it differs from NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_URL_PRODUCTION=
# [optional | config] Staging marketing URL.
NEXT_PUBLIC_SITE_URL_STAGING=https://staging.unioneyes.app
# [optional | config] Canonical app URL for this environment; set per environment so staging does not inherit production metadata.
UE_APP_URL=http://localhost:3002
# [optional | config] Canonical marketing URL for this environment.
UE_MARKETING_URL=http://localhost:3002
# [optional | config] Base URL of the links in authentication emails, when it differs from NEXT_PUBLIC_APP_URL.
APP_BASE_URL=
# [optional | config] Parent-company URL in the marketing footer.
NEXT_PUBLIC_NZILA_URL=https://nzilaventures.com
# [optional | config] Union name used in training notification emails.
NEXT_PUBLIC_UNION_NAME=
# [optional | config] Comma-separated origins allowed to call the API cross-origin.
CORS_ALLOWED_ORIGINS=
# [optional | config] Legacy single-origin spelling of CORS_ALLOWED_ORIGINS.
CORS_ORIGIN=
# [production | config] Canonical URL the authentication library builds callbacks on; the app URL.
AUTH_URL=http://localhost:3002
# [production | flag] true behind the Azure ingress so the authentication library trusts the forwarded host.
AUTH_TRUST_HOST=true
# [optional | config] Legacy canonical application URL used when building the enterprise OIDC callback.
NEXTAUTH_URL=

# ── Database ────────────────────────────────────────────────────────────────────────────────────────
# [production | secret] Tenant-scoped PostgreSQL connection string (the non-bypass union_eyes_runtime role).
DATABASE_URL=
# [production | secret] PostgreSQL connection string of the union_eyes_system role used by system and admin paths.
SYSTEM_DATABASE_URL=
# [production | secret] PostgreSQL connection string of the dedicated authentication gateway role (ordinary auth execution).
AUTH_DATABASE_URL=
# [production | secret] PostgreSQL connection string of the authentication system gateway role (lifecycle, cleanup, MFA admin).
AUTH_SYSTEM_DATABASE_URL=
# [optional | config] Maximum size of the tenant connection pool.
DB_POOL_MAX=20
# [optional | config] Seconds before an idle tenant connection closes.
DB_IDLE_TIMEOUT=30
# [optional | config] Seconds to wait when opening a tenant connection.
DB_CONNECTION_TIMEOUT=10
# [optional | config] Milliseconds before a tenant statement is cancelled.
DB_QUERY_TIMEOUT=30000
# [optional | config] Maximum size of the system connection pool.
SYSTEM_DB_POOL_MAX=5
# [optional | config] Seconds before an idle system connection closes.
SYSTEM_DB_IDLE_TIMEOUT=30
# [optional | config] Seconds to wait when opening a system connection.
SYSTEM_DB_CONNECTION_TIMEOUT=10
# [optional | config] Milliseconds before a system statement is cancelled.
SYSTEM_DB_QUERY_TIMEOUT=30000
# [optional | config] Pool size of the shared @nzila/db client.
DATABASE_POOL_SIZE=20
# [optional | secret] Connection string of the Nzila platform database, for the shared platform client.
PLATFORM_DATABASE_URL=

# ── Authentication (Entra / NextAuth, sessions, MFA) ────────────────────────────────────────────────
# [production | secret] Signing secret of session cookies and authentication tokens: at least 32 characters, not a placeholder.
AUTH_SECRET=
# [production | secret] AES-256-GCM key of the stored TOTP secrets: exactly 64 hex characters. A deployed environment refuses to enrol or verify MFA without it; it is never derived from AUTH_SECRET there.
AUTH_MFA_ENCRYPTION_KEY=
# [production | config] Microsoft Entra directory (tenant) id of the application registration.
AZURE_AD_TENANT_ID=
# [production | config] Application (client) id of the Entra app registration.
AZURE_AD_CLIENT_ID=
# [production | secret] Client secret of the Entra app registration.
AZURE_AD_CLIENT_SECRET=
# [optional | flag] Staging only: pin the issuer to AZURE_AD_TENANT_ID.
AZURE_AD_STAGING_SINGLE_TENANT=
# [optional | config] Staging only: shorter session lifetime for the single-tenant staging registration.
AZURE_AD_STAGING_SESSION_MAX_AGE_SECONDS=
# [optional | flag] false turns the PostgreSQL password-session path off (server side).
NZILA_AUTH_ENABLE_PG_FALLBACK=true
# [optional | flag] Client-side mirror of NZILA_AUTH_ENABLE_PG_FALLBACK (build time).
NEXT_PUBLIC_NZILA_AUTH_ENABLE_PG_FALLBACK=true
# [staging | flag] Staging only: lets the acceptance harness sign in with the acceptance secret. Unset, the acceptance sign-in is off. Refused on any production target.
# UNION_EYES_ACCEPTANCE_AUTH_ENABLED=
# [staging | secret] Staging only: shared secret of the acceptance sign-in (at least 32 characters). Refused on any production target.
# UNION_EYES_ACCEPTANCE_AUTH_SECRET=
# [dev-only | flag] Local/test only: enables Cora acceptance authentication when every environment signal is local.
# CORA_ACCEPTANCE_AUTH_ENABLED=
# [dev-only | secret] Local/test only: signing secret for Cora acceptance identities.
# CORA_ACCEPTANCE_AUTH_SECRET=

# ── Authorization and administrator bootstrap ───────────────────────────────────────────────────────
# [optional | config] Comma-separated user ids that hold platform administrator access across organizations. Empty means nobody does.
PLATFORM_ADMIN_USER_IDS=
# [optional | config] Organization whose administrators get cross-organization super-admin access. Unset disables that access (a warning is logged).
SUPER_ADMIN_ORG_ID=
# [optional | config] Comma-separated extra super-admin email addresses (added to the built-in operator addresses).
SUPER_ADMIN_EMAILS=
# [optional | secret] Bearer token the deployment workflow presents to a candidate host to read its full build identity (at least 32 characters).
UE_CANDIDATE_PROBE_TOKEN=
# [dev-only | config] Development only: act as this role instead of the signed-in role.
# DEV_ROLE_OVERRIDE=
# [dev-only | flag] Development only: fall back to the default organization when a user has none.
# UE_ALLOW_DEFAULT_ORG=
# [dev-only | flag] Development only: let the dashboard link a seeded identity to its seeded membership.
# UE_ALLOW_SEED_MEMBERSHIP_LINKING=

# ── Encryption, signing and integrity keys ──────────────────────────────────────────────────────────
# [production | config] Azure Key Vault holding the PII encryption key. A deployed environment encrypts only through it.
AZURE_KEY_VAULT_URL=
# [optional | config] Name of the Key Vault key that wraps PII.
ENCRYPTION_KEY_NAME=pii-encryption-key
# [optional | config] false disables the scheduled encryption-key rotation check.
KEY_ROTATION_ENABLED=true
# [optional | config] Days before the encryption key is due for rotation.
KEY_MAX_AGE_DAYS=90
# [optional | config] Days the previous key stays valid for decryption after a rotation.
KEY_ROTATION_GRACE_PERIOD_DAYS=30
# [optional | config] Number of encryption key versions kept for decryption.
MAX_KEY_VERSIONS_RETAINED=3
# [dev-only | secret] Development only: base64 32-byte key used when no Key Vault is configured. A deployed environment refuses to start with it set.
# FALLBACK_ENCRYPTION_KEY=
# [production | secret] HMAC secret that signs the immutable audit records (NAR): at least 32 characters, not a placeholder.
NAR_SIGNING_SECRET=
# [production | config] Identifier of the NAR signing key (names the key version a record was signed with, for rotation).
NAR_SIGNING_KEY_ID=
# [optional | config] Key Vault the platform packages (@nzila/os-core secrets, the NAR secret) read from.
KEY_VAULT_URI=
# [production | secret] HMAC key that seals exported evidence packs: at least 32 characters, not a placeholder.
EVIDENCE_SEAL_KEY=
# [production | secret] HMAC secret of the open/click tracking tokens in sent communications: at least 32 characters, not a placeholder.
COMMUNICATIONS_TRACKING_SECRET=
# [optional | secret] Legacy alias of COMMUNICATIONS_TRACKING_SECRET.
RESEND_TRACKING_SECRET=
# [production | secret] Keyed-hash secret of the email suppression list: at least 32 characters, not a placeholder.
EMAIL_SUPPRESSION_HASH_KEY=
# [production | secret] Keyed-hash secret that pseudonymises the network addresses in the public-intake audit trail: at least 32 characters, not a placeholder.
PUBLIC_INTAKE_AUDIT_KEY=
# [production | secret] Secret that blinds and verifies ballots: at least 32 characters, not a placeholder.
VOTING_SECRET=
# [optional | secret] Dedicated HMAC key for unlinkable per-survey participation proofs. Unset, anonymous single-response surveys refuse to open a response.
SURVEY_PARTICIPATION_HMAC_KEY=
# [optional | flag] true refuses to start unless the OpenSSL FIPS provider is active.
NZILA_FIPS_REQUIRED=
# [optional | flag] true makes a non-FIPS algorithm an error instead of a report.
NZILA_FIPS_STRICT=
# [optional | config] OpenSSL configuration file (read to detect a FIPS provider).
OPENSSL_CONF=
# [optional | config] OpenSSL module directory (read to detect a FIPS provider).
OPENSSL_MODULES=

# ── Scheduled jobs and workers ──────────────────────────────────────────────────────────────────────
# [production | secret] Bearer secret every scheduled-job route requires: at least 32 characters, not a placeholder. Unset, every cron route answers 401.
CRON_SECRET_KEY=
# [optional | secret] Legacy alias of CRON_SECRET_KEY.
CRON_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────────────────────────────
# [production | secret] API key of the Resend email provider.
RESEND_API_KEY=
# [production | secret] Signing secret of the Resend delivery webhook (bounces, complaints, opens). Unset, the webhook route answers 503 and nothing is accepted.
RESEND_WEBHOOK_SECRET=
# [optional | config] Sender address of outgoing email.
RESEND_FROM_EMAIL=noreply@unioneyes.app
# [optional | config] Fallback sender address when RESEND_FROM_EMAIL is not set.
EMAIL_FROM=noreply@unioneyes.app
# [optional | config] Reply-to address of outgoing email.
EMAIL_REPLY_TO=support@unioneyes.app
# [optional | config] Outgoing email provider: resend or sendgrid.
EMAIL_PROVIDER=resend
# [optional | secret] API key of the optional SendGrid email provider.
SENDGRID_API_KEY=
# [optional | config] Sender address of the SendGrid provider.
SENDGRID_FROM_EMAIL=
# [optional | config] Sender name of the SendGrid provider.
SENDGRID_FROM_NAME=
# [optional | config] Reply-to address of the SendGrid provider.
SENDGRID_REPLY_TO_EMAIL=
# [optional | config] Administrator mailbox for dues and consent notices.
ADMIN_EMAIL=admin@unioneyes.app
# [optional | config] Data-protection officer mailbox for privacy requests.
DPO_EMAIL=
# [optional | config] Provincial privacy officer mailbox.
PRIVACY_OFFICER_EMAIL=

# ── SMS and push notifications ──────────────────────────────────────────────────────────────────────
# [optional | config] Twilio account SID of the SMS provider.
TWILIO_ACCOUNT_SID=
# [optional | secret] Twilio auth token of the SMS provider.
TWILIO_AUTH_TOKEN=
# [optional | config] Twilio sender phone number (E.164).
TWILIO_PHONE_NUMBER=
# [optional | secret] Firebase service-account JSON of the push provider.
FIREBASE_SERVICE_ACCOUNT=

# ── Calendar sync ───────────────────────────────────────────────────────────────────────────────────
# [optional | secret] Signs the calendar OAuth state parameter (at least 32 bytes); falls back to CALENDAR_TOKEN_ENCRYPTION_KEY. Unset, no calendar connection can start.
CALENDAR_OAUTH_STATE_SECRET=
# [optional | secret] AES-256 key (64 hex characters) that encrypts stored calendar tokens. Unset, tokens are neither stored nor read.
CALENDAR_TOKEN_ENCRYPTION_KEY=
# [dev-only | flag] Development only: read calendar tokens that were stored in plaintext.
# CALENDAR_TOKEN_ALLOW_LEGACY_PLAINTEXT=
# [optional | config] OAuth client id of the Google Calendar integration.
GOOGLE_CALENDAR_CLIENT_ID=
# [optional | secret] OAuth client secret of the Google Calendar integration.
GOOGLE_CALENDAR_CLIENT_SECRET=
# [optional | config] OAuth callback URL registered with Google: <app URL>/api/calendar-sync/google/callback.
GOOGLE_CALENDAR_REDIRECT_URI=
# [optional | config] OAuth client id of the Microsoft Calendar integration.
MICROSOFT_CALENDAR_CLIENT_ID=
# [optional | secret] OAuth client secret of the Microsoft Calendar integration.
MICROSOFT_CALENDAR_CLIENT_SECRET=
# [optional | config] OAuth callback URL registered with Microsoft: <app URL>/api/calendar-sync/microsoft/callback.
MICROSOFT_CALENDAR_REDIRECT_URI=
# [optional | config] Directory the Microsoft Calendar OAuth app signs in against.
MICROSOFT_TENANT_ID=
# [optional | config] Minimum minutes between syncs of one calendar connection.
CALENDAR_SYNC_INTERVAL_MINUTES=30

# ── Document storage and malware scanning ───────────────────────────────────────────────────────────
# [production | config] Azure Storage account that holds documents and audit records.
AZURE_STORAGE_ACCOUNT_NAME=
# [production | secret] Access key of the Azure Storage account.
AZURE_STORAGE_ACCOUNT_KEY=
# [optional | config] Blob container of member documents.
AZURE_BLOB_CONTAINER=union-eyes
# [dev-only | config] Development only: blob endpoint override (the Azurite emulator). Refused on any production runtime.
# AZURE_STORAGE_BLOB_ENDPOINT=
# [optional | secret] Connection string of an Azure Storage account: selects Azure as the e-signature document backend, and is accepted for NAR records.
AZURE_STORAGE_CONNECTION_STRING=
# [optional | config] Blob container of e-signature documents (Azure backend).
AZURE_STORAGE_CONTAINER=signatures
# [optional | config] Fallback name of the immutable audit-record container.
AZURE_STORAGE_CONTAINER_NAME=
# [optional | config] Immutable (WORM) container of NAR audit records.
NAR_AUDIT_CONTAINER_NAME=audit-records
# [optional | config] locked (default) or unlocked retention policy of NAR blobs.
NAR_IMMUTABILITY_LOCK_MODE=locked
# [optional | flag] false skips the legal hold on NAR blobs.
NAR_LEGAL_HOLD=true
# [dev-only | config] Development only: local_sandbox writes NAR records to a local directory (never immutable).
# NAR_STORAGE_MODE=
# [dev-only | config] Development only: directory of the local NAR sandbox.
# NAR_LOCAL_SANDBOX_DIR=
# [production | config] ClamAV scan endpoint. Unset or unreachable, every upload is refused in a deployed environment.
CLAMAV_URL=
# [dev-only | flag] Development only: accept an upload when the scanner is unavailable. Ignored on any deployed runtime.
# CLAMAV_FAIL_OPEN=false
# [optional | config] Comma-separated approved storage hosts for attached interview documents.
UE_DOCUMENT_STORAGE_HOSTS=nzilacanadastore.blob.core.windows.net
# [optional | config] Cloudflare R2 endpoint: selects R2 as the e-signature document backend.
CLOUDFLARE_R2_ENDPOINT=
# [optional | secret] Cloudflare R2 access key id.
CLOUDFLARE_R2_ACCESS_KEY_ID=
# [optional | secret] Cloudflare R2 secret access key.
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# [optional | config] Cloudflare R2 bucket of e-signature documents.
CLOUDFLARE_R2_BUCKET=
# [optional | secret] AWS access key id of the S3 e-signature document backend (the default backend).
AWS_ACCESS_KEY_ID=
# [optional | secret] AWS secret access key of the S3 e-signature document backend.
AWS_SECRET_ACCESS_KEY=
# [optional | config] AWS region of the S3 backends.
AWS_REGION=
# [optional | config] S3 bucket of e-signature documents.
AWS_SIGNATURES_BUCKET=

# ── Payments and billing ────────────────────────────────────────────────────────────────────────────
# [optional | secret] Stripe secret API key.
STRIPE_SECRET_KEY=
# [optional | secret] Signing secret of the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# [optional | config] Stripe environment label: test or live.
STRIPE_ENVIRONMENT=
# [optional | config] Refund amount (cents) above which a second approval is required.
STRIPE_REFUND_APPROVAL_THRESHOLD_CENTS=
# [optional | config] Default checkout currency (ISO 4217).
STRIPE_DEFAULT_CURRENCY=CAD
# [optional | config] Stripe price id of the ICRA brief.
STRIPE_PRICE_ICRA_BRIEF=
# [optional | config] Stripe price id of the ICRA diagnostic.
STRIPE_PRICE_ICRA_DIAGNOSTIC=
# [optional | config] Stripe price id of the self-guided workbook.
STRIPE_PRICE_WORKBOOK_SELF_GUIDED=
# [optional | config] PayPal REST client id (webhook verification).
PAYPAL_CLIENT_ID=
# [optional | secret] PayPal REST client secret (webhook verification).
PAYPAL_CLIENT_SECRET=
# [optional | config] Id of the PayPal webhook subscription (webhook verification).
PAYPAL_WEBHOOK_ID=
# [optional | flag] true turns the Shopify rewards integration on.
SHOPIFY_ENABLED=false
# [optional | config] Shopify shop domain of the rewards store.
SHOPIFY_SHOP_DOMAIN=
# [optional | secret] Shopify Admin API token.
SHOPIFY_ADMIN_TOKEN=
# [optional | secret] Shopify Storefront API token.
SHOPIFY_STOREFRONT_TOKEN=
# [optional | secret] Signing secret of the Shopify webhooks.
SHOPIFY_WEBHOOK_SECRET=
# [optional | config] Institution-approved mandate reference required before a prepared pension settlement may be handed to a provider.
PENSION_SETTLEMENT_PROVIDER_MANDATE_REF=
# [optional | config] Approved debit ledger account used for reconciliation postings.
UE_RECONCILIATION_DEBIT_ACCOUNT=
# [optional | config] Approved credit ledger account used for reconciliation postings; must differ from the debit account.
UE_RECONCILIATION_CREDIT_ACCOUNT=

# ── AI, machine learning and voice ──────────────────────────────────────────────────────────────────
# [optional | config] Base URL of the AI runtime the AI client calls.
AI_SDK_BASE_URL=
# [optional | secret] Dedicated to AI runtime communication. Not accepted for Union Eyes operational metrics.
AI_SERVICE_KEY=
# [optional | secret] Scoped service credential for metrics:platform_operational:read, at least 32 characters and distinct from AI_SERVICE_KEY and QUEUE_STATUS_SERVICE_KEY. Never confers tenant content access.
UE_METRICS_SERVICE_KEY=
# [optional | config] URL of the external AI service behind the ML query route.
AI_SERVICE_URL=
# [optional | secret] Bearer token for the external AI service (at least 32 characters).
AI_SERVICE_TOKEN=
# [optional | config] Approved policy/evidence reference required before any natural-language query is disclosed to the external ML provider.
ML_QUERY_DISCLOSURE_POLICY_REF=
# [optional | secret] Service key of /api/union-eyes/queue-status: 32+ characters, distinct from AI_SERVICE_KEY and UE_METRICS_SERVICE_KEY, no AI-key fallback. Unset, short or re-used, the machine path answers 401.
QUEUE_STATUS_SERVICE_KEY=
# [optional | config] Azure OpenAI endpoint (voice transcription).
AZURE_OPENAI_ENDPOINT=
# [optional | secret] Azure OpenAI API key (voice transcription).
AZURE_OPENAI_API_KEY=
# [optional | config] Dedicated Whisper endpoint.
AZURE_OPENAI_WHISPER_ENDPOINT=
# [optional | secret] Dedicated Whisper API key.
AZURE_OPENAI_WHISPER_API_KEY=
# [optional | config] Whisper deployment name.
AZURE_OPENAI_WHISPER_DEPLOYMENT=
# [optional | config] Model (deployment) name the copilot, insights and chatbot routes request.
AZURE_OPENAI_DEPLOYMENT=gpt-4
# [optional | secret] Azure Speech key.
AZURE_SPEECH_KEY=
# [optional | config] Azure Speech region.
AZURE_SPEECH_REGION=
# [optional | config] Azure Computer Vision endpoint (OCR).
AZURE_COMPUTER_VISION_ENDPOINT=
# [optional | secret] Azure Computer Vision key (OCR).
AZURE_COMPUTER_VISION_KEY=
# [optional | config] AI runtime profile the text-generation service requests.
UE_MAMBA_PROFILE_KEY=
# [optional | config] Confidence at or above which a classification is accepted without review.
UE_AUTO_CLASSIFICATION_ACCEPT_THRESHOLD=
# [optional | config] Confidence at or above which a classification goes to review instead of being discarded.
UE_AUTO_CLASSIFICATION_REVIEW_THRESHOLD=
# [optional | flag] true turns on ML relevance in case intelligence.
FEATURE_CASE_INTELLIGENCE_V1_ML=false
# [optional | flag] false turns off pattern relevance in case intelligence.
FEATURE_CASE_INTELLIGENCE_V1_PATTERNS=true
# [optional | config] Documents the CBA ingestion processes concurrently.
CBA_INTEL_DOCUMENT_CONCURRENCY=1
# [optional | config] Sources the CBA ingestion processes concurrently.
CBA_INTEL_SOURCE_CONCURRENCY=1
# [optional | config] Retries per document fetch in the CBA ingestion.
CBA_INTEL_FETCH_RETRIES=2
# [optional | config] Milliseconds before a CBA document fetch times out.
CBA_INTEL_FETCH_TIMEOUT_MS=
# [optional | config] Reviews one CBA extraction run may enqueue automatically.
CBA_INTEL_MAX_AUTO_REVIEW_ENQUEUES=20
# [optional | config] Confidence below which a CBA extraction goes to review.
CBA_INTEL_REVIEW_CONFIDENCE_THRESHOLD=

# ── CRM and external data sources ───────────────────────────────────────────────────────────────────
# [optional | secret] HubSpot private-app token.
HUBSPOT_API_KEY=
# [optional | config] HubSpot pipeline stage id: workbook, self-guided purchased.
HUBSPOT_PIPELINE_STAGE_WORKBOOK_SELF_GUIDED_PURCHASED=
# [optional | config] HubSpot pipeline stage id: workbook, facilitated interest.
HUBSPOT_PIPELINE_STAGE_WORKBOOK_FACILITATED_INTEREST=
# [optional | config] HubSpot pipeline stage id: workbook, enterprise inquiry.
HUBSPOT_PIPELINE_STAGE_WORKBOOK_ENTERPRISE_INQUIRY=
# [optional | config] Statistics Canada API base URL.
STATCAN_API_URL=
# [optional | secret] Statistics Canada API key.
STATCAN_API_KEY=
# [optional | config] Canadian Labour Congress API URL (smart onboarding lookup).
CLC_API_URL=
# [optional | secret] Canadian Labour Congress API key (smart onboarding lookup).
CLC_API_KEY=
# [optional | secret] DocuSign integration key.
DOCUSIGN_API_KEY=
# [optional | config] DocuSign API account id.
DOCUSIGN_API_ACCOUNT_ID=
# [optional | config] Legacy spelling of DOCUSIGN_API_ACCOUNT_ID.
DOCUSIGN_ACCOUNT_ID=
# [optional | config] DocuSign environment: sandbox or production.
DOCUSIGN_ENVIRONMENT=
# [optional | secret] HelloSign (Dropbox Sign) API key.
HELLOSIGN_API_KEY=
# [optional | config] LinkedIn OAuth client id.
LINKEDIN_CLIENT_ID=
# [optional | secret] LinkedIn OAuth client secret.
LINKEDIN_CLIENT_SECRET=
# [optional | config] Meta app id.
META_APP_ID=
# [optional | secret] Meta app secret.
META_APP_SECRET=
# [optional | config] Twitter (X) OAuth client id.
TWITTER_CLIENT_ID=
# [optional | secret] Twitter (X) OAuth client secret.
TWITTER_CLIENT_SECRET=

# ── Observability, rate limiting and caching ────────────────────────────────────────────────────────
# [production | secret] Redis connection string of the shared rate-limit and cache store.
REDIS_URL=
# [optional | config] Upstash Redis REST URL: the store the rate limiter prefers when both it and its token are set.
UPSTASH_REDIS_REST_URL=
# [optional | secret] Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN=
# [optional | config] Milliseconds a rate-limit check waits on the store.
RATE_LIMIT_STORE_TIMEOUT_MS=2000
# [optional | config] Key prefix of the Redis cache.
CACHE_KEY_PREFIX=unioneyes
# [optional | config] Default cache lifetime in seconds.
CACHE_DEFAULT_TTL=300
# [optional | config] true warms the cache at start.
CACHE_WARMUP_ENABLED=false
# [optional | config] Days of analytics performance data kept.
ANALYTICS_RETENTION_DAYS=30
# [optional | config] Sentry DSN for the server and edge runtimes.
SENTRY_DSN=
# [optional | config] Sentry DSN for the browser (build time).
NEXT_PUBLIC_SENTRY_DSN=
# [optional | flag] false turns browser error reporting off (build time).
NEXT_PUBLIC_SENTRY_ENABLED=true
# [optional | flag] true lets browser error reporting run on demo hosts (build time).
NEXT_PUBLIC_SENTRY_ENABLE_ON_DEMO=false
# [optional | config] OTLP endpoint of the OpenTelemetry collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
# [optional | config] debug turns on debug logging in the platform telemetry logger.
LOG_LEVEL=info
# [optional | config] Version label shown by the status page.
APP_VERSION=
# [optional | flag] true makes /api/ready require the Django job backend to be ready.
READY_REQUIRE_QUEUE=false
# [optional | flag] true makes /api/ready require the Azure Blob document container to exist.
READY_REQUIRE_STORAGE=false
# [optional | flag] true makes /api/ready require the email provider (EMAIL_PROVIDER and its key and sender) to be configured.
READY_REQUIRE_EMAIL_DELIVERY=false
# [optional | flag] true makes /api/ready require both the Google and the Microsoft calendar client settings.
READY_REQUIRE_CALENDAR_INTEGRATIONS=false
# [optional | flag] true makes /api/ready require the calendar token encryption key.
READY_REQUIRE_CALENDAR_TOKEN_ENCRYPTION=false
# [optional | config] Digest of the running frontend image, reported by /api/version.
UE_FRONTEND_IMAGE_DIGEST=
# [optional | config] Digest of the running backend image, reported by /api/version.
UE_BACKEND_IMAGE_DIGEST=
# [optional | config] Internal URL of the Django backend (server side).
DJANGO_API_URL=
# [optional | config] Public (build-time) URL of the Django backend; the server falls back to it when DJANGO_API_URL is unset.
NEXT_PUBLIC_DJANGO_API_URL=

# ── Public intake and bot challenge ─────────────────────────────────────────────────────────────────
# [production | secret] Cloudflare Turnstile secret that verifies the bot challenge of the public intake and ICRA forms. Unset in a deployed environment, every challenge fails and the forms answer 503.
TURNSTILE_SECRET_KEY=
# [production | config] Cloudflare Turnstile site key rendered by the public forms (build argument). Unset, the widget is not rendered and the forms cannot be submitted.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# [optional | config] Number of trusted reverse-proxy hops in front of the app (public intake client address).
TRUSTED_PROXY_HOPS=1
# [optional | config] Number of trusted reverse-proxy hops in front of the app (e-signature signer address).
UE_TRUSTED_PROXY_HOPS=1
# [optional | config] Switches the ICRA scoring to the public-sector weighting.
OCI_PUBLIC_SECTOR_MODE=

# ── Compliance, privacy and consent text ────────────────────────────────────────────────────────────
# [optional | config] Version label (at most 10 characters) of the institution-adopted location-consent notice. Unset, location consent cannot be granted.
UE_LOCATION_CONSENT_NOTICE_VERSION=
# [optional | config] Exact member-facing text (at most 4000 characters) of the location-consent notice. Unset, location consent cannot be granted.
UE_LOCATION_CONSENT_NOTICE_TEXT=
# [optional | config] Version label of the approved voice-processing disclosure. Unset, voice upload answers 503.
UE_VOICE_DISCLOSURE_NOTICE_VERSION=
# [optional | config] English (Canada) text of the approved voice-processing disclosure. Unset, voice upload answers 503.
UE_VOICE_DISCLOSURE_NOTICE_EN_CA=
# [optional | config] French (Canada) text of the approved voice-processing disclosure. Unset, voice upload answers 503.
UE_VOICE_DISCLOSURE_NOTICE_FR_CA=
# [optional | config] Reference of the institutional approval of the voice-processing disclosure. Unset, voice upload answers 503.
UE_VOICE_DISCLOSURE_APPROVAL_REFERENCE=

# ── Optional third-party integrations ───────────────────────────────────────────────────────────────
# [optional | config] Workday OAuth client id.
WORKDAY_CLIENT_ID=
# [optional | secret] Workday OAuth client secret.
WORKDAY_CLIENT_SECRET=
# [optional | config] Workday tenant id.
WORKDAY_TENANT_ID=
# [optional | secret] BambooHR API key.
BAMBOOHR_API_KEY=
# [optional | config] BambooHR company subdomain.
BAMBOOHR_SUBDOMAIN=
# [optional | config] ADP client id.
ADP_CLIENT_ID=
# [optional | secret] ADP client secret.
ADP_CLIENT_SECRET=
# [optional | config] QuickBooks OAuth client id.
QUICKBOOKS_CLIENT_ID=
# [optional | secret] QuickBooks OAuth client secret.
QUICKBOOKS_CLIENT_SECRET=
# [optional | config] Xero OAuth client id.
XERO_CLIENT_ID=
# [optional | secret] Xero OAuth client secret.
XERO_CLIENT_SECRET=
# [optional | secret] Sun Life API key.
SUNLIFE_API_KEY=
# [optional | secret] Sun Life API secret.
SUNLIFE_API_SECRET=
# [optional | config] Manulife client id.
MANULIFE_CLIENT_ID=
# [optional | secret] Manulife client secret.
MANULIFE_CLIENT_SECRET=
# [optional | secret] Ontario Teachers pension plan API key.
OTPP_API_KEY=
# [optional | config] Slack OAuth client id.
SLACK_CLIENT_ID=
# [optional | secret] Slack OAuth client secret.
SLACK_CLIENT_SECRET=
# [optional | config] Microsoft Teams app client id.
MSTEAMS_CLIENT_ID=
# [optional | secret] Microsoft Teams app client secret.
MSTEAMS_CLIENT_SECRET=
# [optional | config] Microsoft Teams directory (tenant) id.
MSTEAMS_TENANT_ID=

# ── Django backend ──────────────────────────────────────────────────────────────────────────────────
# [production | secret] Django SECRET_KEY: at least 50 characters, not a placeholder. A serving Django process (gunicorn, celery) refuses to start without it.
DJANGO_SECRET_KEY=
# [production | secret] HMAC secret of the signed-request middleware: its own value, never derived from DJANGO_SECRET_KEY. A serving Django process refuses to start without it.
REQUEST_SIGNING_SECRET=
# [production | secret] Default HMAC secret of outbound webhooks: its own value, never derived from DJANGO_SECRET_KEY. A serving Django process refuses to start without it.
WEBHOOK_DEFAULT_SECRET=
# [dev-only | flag] Development only: Django debug mode. Refused when DJANGO_ALLOWED_HOSTS names a non-local host.
# DJANGO_DEBUG=false
# [production | config] Comma-separated host names Django serves. Unset, only localhost is accepted and every real host is refused with 400.
DJANGO_ALLOWED_HOSTS=
# [production | config] PostgreSQL host of the Django backend. A serving Django process refuses to start without it.
PGHOST=
# [production | config] PostgreSQL role of the Django backend (the least-privilege runtime role, never postgres).
PGUSER=
# [production | secret] Password of the PostgreSQL role of the Django backend. A serving Django process refuses to start without it.
PGPASSWORD=
# [optional | config] PostgreSQL database of the Django backend.
PGDATABASE=nzila_union_eyes
# [optional | config] PostgreSQL port of the Django backend.
PGPORT=5432
# [production | config] JWKS endpoint of the Entra tenant Django verifies bearer tokens against. Unset, no token verifies and every authenticated call is refused.
AUTH_JWKS_URL=
# [production | config] Token issuer Django requires (the Entra tenant issuer URL).
AUTH_ISSUER=
# [production | config] Token audience Django requires (the application client id).
AUTH_AUDIENCE=
# [optional | config] Namespace prefixed to external identity ids in Django.
AUTH_PROVIDER_NAMESPACE=entra
# [optional | secret] Signing secret of the inbound identity webhook. Unset, Django refuses every webhook call.
AUTH_WEBHOOK_SECRET=
# [optional | config] Seconds Django keeps a database connection open (PgBouncer pools the rest).
CONN_MAX_AGE=600
# [optional | config] Celery broker URL.
CELERY_BROKER_URL=
# [optional | config] Celery result backend.
CELERY_RESULT_BACKEND=django-db
# [optional | config] Directory the report tasks write to and the GDPR export download reads from.
REPORTS_DIR=
# [optional | config] Scratch directory of the Django cleanup task.
TEMP_DIR=
# [optional | config] Directory of jurisdiction policy files that replaces the shipped ones.
JURISDICTION_POLICIES_PATH=
# [optional | config] Canonical V2 process role of Django: web or worker.
UE_V2_PROCESS_CONTEXT=web

# ── Development, testing and escape hatches (never in a deployed environment) ───────────────────────
# [dev-only | flag] Development only: enables the QA behaviours (detailed errors, the pilot flag). Refused on any deployed runtime.
# QA_TEST_ENV=
# [dev-only | flag] Development only: lets the Playwright suite sign in with a seeded session. Ignored on any deployed runtime.
# PLAYWRIGHT_TEST_AUTH=
# [dev-only | flag] Development only: skips the sign-in risk assessment for end-to-end tests.
# UE_E2E_RISK_BYPASS=
# [dev-only | config] Development only: organization the staging seed populates.
# STAGING_SEED_ORG_ID=
# [staging | flag] Staging only: opens the staging proof routes; unset, they refuse. Refused on any production identity.
# STAGING_PROOFS_ENABLED=
# [staging | secret] Staging only: shared secret of the staging proof routes (at least 32 characters). Refused on any production identity.
# STAGING_PROOF_SECRET=
# [staging | config] Staging only: runtime identifier the staging proof binds to; unset, the proof refuses.
# UNION_EYES_RUNTIME_ID=
# [dev-only | flag] Development only: skip the database check at server start. Ignored on any deployed runtime.
# SKIP_DB_STARTUP_CHECK=
# [optional | config] Directory of the whitepaper source documents.
WHITEPAPER_DOCS_ROOT=

# ── Build and platform-injected ─────────────────────────────────────────────────────────────────────
# [optional | config] Set by Next.js; boot checks skip the build phase.
NEXT_PHASE=
# [optional | config] Set by Next.js: the runtime a module executes in.
NEXT_RUNTIME=
# [optional | config] Next.js build id.
BUILD_ID=
# [optional | flag] true runs the bundle analyzer during the build.
ANALYZE=
# [optional | config] Build timestamp reported in build metadata.
BUILD_TIME=
# [optional | config] Legacy alias of BUILD_TIME.
BUILD_TIMESTAMP=
# [optional | config] Release identifier reported in build metadata.
RELEASE_ID=
# [optional | config] Image artifact identifier reported in build metadata.
ARTIFACT_ID=
# [optional | config] Commit the build was made from.
GITHUB_SHA=
# [optional | config] Commit variable of a Vercel build; build metadata only.
VERCEL_GIT_COMMIT_SHA=
# [optional | config] Vercel environment; read only as a production signal by the NAR local-sandbox gate.
VERCEL_ENV=
# [optional | config] Environment label in build metadata.
APP_ENV=
# [optional | config] Package version npm sets; recorded as the NAR system version.
npm_package_version=
# [optional | config] Container host name; names the deadline worker instance.
HOSTNAME=
# [optional | config] Port the server listens on; the container ingress targets 3000.
PORT=3000
# [optional | config] Client id of the user-assigned managed identity of the container app.
AZURE_CLIENT_ID=
# [optional | config] PostgreSQL SSL mode of the Django backend.
PGSSLMODE=require
# [optional | config] Build argument: which apps the image build compiles.
TURBO_FILTER=
# [optional | config] Build argument: placeholder secret used while compiling.
BUILD_AUTH_PLACEHOLDER=
