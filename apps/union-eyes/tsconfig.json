{
  "extends": "@nzila/config/tsconfig/nextjs",
  "compilerOptions": {
    "noImplicitAny": true,
    "useUnknownInCatchVariables": false,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./*"],
      "@nzila/db": ["../../packages/db/src/index.ts"],
      "@nzila/db/schema": ["../../packages/db/src/schema/index.ts"],
      "@nzila/db/client": ["../../packages/db/src/client.ts"],
      "@nzila/db/raw": ["../../packages/db/src/raw.ts"],
      "@nzila/db/scoped": ["../../packages/db/src/scoped.ts"],
      "@nzila/db/audit": ["../../packages/db/src/audit.ts"],
      "@nzila/db/platform": ["../../packages/db/src/platform.ts"],
      "@nzila/ml-sdk": ["../../packages/ml-sdk/src/index.ts"],
      "@nzila/os-core": ["../../packages/os-core/src/index.ts"],
      "@nzila/os-core/policy": ["../../packages/os-core/src/policy/index.ts"],
      "@nzila/os-core/evidence": ["../../packages/os-core/src/evidence/index.ts"],
      "@nzila/os-core/config": ["../../packages/os-core/src/config/env.ts"],
      "@nzila/os-core/secrets": ["../../packages/os-core/src/secrets/keyvault.ts"],
      "@nzila/os-core/rateLimit": ["../../packages/os-core/src/rateLimit.ts"],
      "@nzila/os-core/telemetry": ["../../packages/os-core/src/telemetry/index.ts"],
      "@nzila/platform-pilot-metrics": ["../../packages/platform-pilot-metrics/src/index.ts"],
      "@nzila/platform-pilot-metrics-types": ["../../packages/platform-pilot-metrics-types/src/index.ts"],
      "@nzila/blob": ["../../packages/blob/src/index.ts"],
      "@nzila/ai-sdk": ["../../packages/ai-sdk/src/index.ts"],
      "@nzila/ai-sdk/types": ["../../packages/ai-sdk/src/types.ts"],
      "@nzila/payments-stripe": ["../../packages/payments-stripe/src/index.ts"],
      "@nzila/cupe-vocabulary": ["../../packages/cupe-vocabulary/src/index.ts"],
      "@nzila/cupe-vocabulary/types": ["../../packages/cupe-vocabulary/src/types.ts"],
      "@nzila/policies": ["../../packages/policies/src/index.ts"]
      ,"@nzila/platform-ontology/schema": ["../../packages/platform-ontology/src/schema.ts"]
      ,"@nzila/platform-event-fabric/schema": ["../../packages/platform-event-fabric/src/schema.ts"]
      ,"@nzila/platform-knowledge-registry/schema": ["../../packages/platform-knowledge-registry/src/schema.ts"]
      ,"@nzila/platform-data-fabric/schema": ["../../packages/platform-data-fabric/src/schema.ts"]
      ,"@nzila/platform-decision-graph/schema": ["../../packages/platform-decision-graph/src/schema.ts"]
      ,"@nzila/platform-semantic-search/schema": ["../../packages/platform-semantic-search/src/schema.ts"]
      ,"@nzila/platform-governed-ai/schema": ["../../packages/platform-governed-ai/src/schema.ts"]
      ,"@nzila/platform-reasoning-engine/schema": ["../../packages/platform-reasoning-engine/src/schema.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "global.d.ts",
    "modules.d.ts",
    "i18n.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "files": [
    "db/queries/claims-queries.ts",
    "lib/workflow-engine.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".turbo",
    "dist",
    "archive",
    "backups",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "lib/workflow-automation-engine.ts",
    "lib/services/transfer-pricing-service.ts",
    "lib/workers/**",
    "lib/graphql/**",
    "lib/gdpr/**",
    "lib/social-media/**",
    "lib/settlement-recommendation-engine.ts",
    "lib/utils/pdf-generator.ts",
    "lib/chart-utils.ts",
    "nzila-scripts-book-template/**",
    "app/api/social-media/**",
    "mobile/**",
    "db/schema/**",
    "db/migrations/**",
    "db/queries/**",
    "services/**",
    "backend/**",
    "infra/**",
    "lib/external-calendar-sync/**",
    "lib/integrations/**",
    "e2e/**",
    "tests/e2e/**"
  ]
}
