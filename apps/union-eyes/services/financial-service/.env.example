# Financial Service Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3007
SERVICE_NAME=financial-service

# Database Configuration
# financial-service runs as a separate process against the SAME canonical
# Union Eyes Azure PostgreSQL data plane as the main application (not a
# separate physical database) - see reports/union-eyes-canonical-database-
# topology-round58d.md. Use the connection string for this service's
# approved least-privilege DB role/principal.
DATABASE_URL=postgresql://union_eyes_finance_runtime:your_password@your-canonical-postgres-host:5432/union_eyes

# Authentication (Entra External ID / NextAuth)
AUTH_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# CORS Configuration (Security Hardened - Feb 2026)
# Comma-separated list of allowed origins. Never use wildcard (*) in production.
# Development: localhost origins are automatically allowed  
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Calculation Engine
LATE_FEE_GRACE_PERIOD_DAYS=7
DEFAULT_LATE_FEE_PERCENTAGE=5.0
DEFAULT_LATE_FEE_FLAT_AMOUNT=10.00

# Email Configuration (for receipts)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
EMAIL_FROM=noreply@unionclaims.com

# Redis (for caching and rate limiting - optional)
REDIS_URL=redis://localhost:6379

# Feature Flags
ENABLE_STRIPE_PAYMENTS=true
ENABLE_NFC_CHECKIN=true
ENABLE_GPS_VERIFICATION=true
ENABLE_AI_PREDICTIONS=false
