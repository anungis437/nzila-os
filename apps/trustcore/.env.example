# @nzila/trustcore — environment template
# Copy to .env.local and fill in values for local development.

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=trustcore
PORT=3010

# --- Database (shared @nzila/db) ---
DATABASE_URL=postgresql://nzila:nzila_dev@localhost:5433/nzila_automation

# --- Auth (@nzila/platform-auth) ---
AUTH_SECRET=change-me-in-local
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Stripe (optional, for billing surfaces) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
