# ─── Zonga — Environment Configuration ───────────────────────────────────────
# Copy to .env.local and fill in values. See packages/os-core/src/config/env.ts
# for the Zod schema that validates these at startup.

# ── Required ─────────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://nzila:nzila_dev@localhost:5433/nzila_automation

# Clerk authentication (https://dashboard.clerk.com → API Keys)
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Optional — Stripe (payments & payouts) ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...

# ── Optional — Azure Blob Storage (audio, covers, encoded files) ─────────────
BLOB_CONNECTION_STRING=
BLOB_ACCOUNT_NAME=
BLOB_CONTAINER_NAME=zonga-audio

# Also used by the health check endpoint:
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# ── Optional — Observability (OpenTelemetry) ────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=zonga

# ── Optional — AI / ML gateway ──────────────────────────────────────────────
AI_CORE_URL=http://localhost:4100
AI_API_KEY=
ML_CORE_URL=http://localhost:4200
ML_API_KEY=

# ── Optional — Key Vault ────────────────────────────────────────────────────
KEY_VAULT_URI=

# ── Optional — Rate limiting (defaults: 120 req / 60s window) ───────────────
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ── Optional — Clerk webhook (for user sync) ────────────────────────────────
CLERK_WEBHOOK_SECRET=whsec_...

# ── Optional — App URL (auto-detected in most environments) ─────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3011
