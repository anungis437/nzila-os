# Zonga Django Backend — Environment Variables
# Copy to .env and fill in values

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True

# Database (shared with Drizzle — nzila_automation)
PGHOST=localhost
PGPORT=5433
PGDATABASE=nzila_automation
PGUSER=nzila
PGPASSWORD=nzila_dev

# Redis
REDIS_URL=redis://localhost:6379/2

# Clerk
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev

# Celery
CELERY_BROKER_URL=redis://localhost:6379/3

# CORS (Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3006
