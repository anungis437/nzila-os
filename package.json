{
  "name": "nzila-os",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@nzila/web",
    "dev:console": "turbo dev --filter=@nzila/console",
    "dev:flow": "turbo dev --filter=@nzila/flow",
    "dev:docker": "turbo dev --filter=@nzila/web --filter=@nzila/console --filter=@nzila/partners --filter=@nzila/union-eyes --filter=@nzila/abr --continue",
    "build": "turbo build",
    "build:web": "turbo build --filter=@nzila/web...",
    "build:console": "turbo build --filter=@nzila/console...",
    "build:partners": "turbo build --filter=@nzila/partners...",
    "build:union-eyes": "turbo build --filter=@nzila/union-eyes...",
    "build:abr": "turbo build --filter=@nzila/abr...",
    "build:cfo": "turbo build --filter=@nzila/cfo...",
    "build:trade": "turbo build --filter=@nzila/trade...",
    "build:agrimo": "turbo build --filter=@nzila/agrimo...",
    "build:cora": "turbo build --filter=@nzila/cora...",
    "build:zonga": "turbo build --filter=@nzila/zonga...",
    "build:nacp-exams": "turbo build --filter=@nzila/nacp-exams...",
    "build:flow": "turbo build --filter=@nzila/flow...",
    "build:control-plane": "turbo build --filter=@nzila/control-plane...",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:all": "vitest run",
    "test:fast": "vitest run --project=!contract-tests",
    "test:changed": "turbo test --filter='...[HEAD~1]' --output-logs=new-only",
    "test:platform": "vitest run --project @nzila/platform-contracts --project @nzila/platform-auth --project @nzila/platform-shell --project @nzila/platform-notifications --project @nzila/platform-billing --project @nzila/org",
    "test:coverage": "turbo test:coverage",
    "contract-tests": "vitest run --project contract-tests",
    "contract:test": "vitest run --project contract-tests",
    "proof:run": "tsx scripts/proof/run-proof.ts",
    "proof:verify": "tsx scripts/proof/verify-artifacts.ts",
    "proof:clean": "tsx scripts/proof/clean-proof-artifacts.ts",
    "release": "changeset publish",
    "version-packages": "changeset version",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "secret-scan": "gitleaks detect --source . --config .gitleaks.toml --no-banner --verbose",
    "ga-check": "tsx tooling/ga-check/ga-check.ts",
    "redteam": "tsx security/redteam/profile-runner.ts",
    "redteam:core": "tsx security/redteam/profile-runner.ts --profile core",
    "redteam:abr": "tsx security/redteam/profile-runner.ts --profile abr-insights",
    "pilot:check": "tsx scripts/pilot-check.ts",
    "rfp:generate": "tsx scripts/rfp-generate.ts --out docs/rfp/answers.md",
    "demo:golden": "tsx scripts/demo-golden-path.ts",
    "demo:seed": "pnpm --filter @nzila/flow demo:seed && pnpm --filter @nzila/cfo demo:seed && pnpm --filter @nzila/partners demo:seed && pnpm --filter @nzila/web demo:seed",
    "governance:check": "tsx scripts/governance-check.ts",
    "package:ownership:check": "tsx scripts/package-ownership-check.ts",
    "deps:check": "tsx scripts/dependency-boundary-check.ts",
    "ai:contract:check": "tsx scripts/ai-contract-check.ts",
    "control-plane:check": "tsx scripts/control-plane-check.ts",
    "app:gold-standard:check": "tsx scripts/app-gold-standard-check.ts",
    "package:deprecation:check": "tsx scripts/package-deprecation-check.ts",
    "architecture:layers:check": "tsx scripts/architecture-layer-check.ts",
    "app:lifecycle:check": "tsx scripts/app-lifecycle-check.ts",
    "registry:check": "tsx scripts/platform-registry-check.ts",
    "control-plane:surface:check": "tsx scripts/control-plane-surface-check.ts",
    "control-plane:coherence:check": "tsx scripts/control-plane-coherence-check.ts",
    "platform:surface:model:check": "tsx scripts/platform-surface-model-check.ts",
    "platform:contract:check": "tsx scripts/platform-contract-check.ts",
    "app:domain-core:check": "tsx scripts/app-domain-core-check.ts",
    "registry:consistency:check": "tsx scripts/registry-consistency-check.ts",
    "architecture:check": "pnpm architecture:layers:check && pnpm app:domain-core:check && pnpm platform:surface:model:check && pnpm platform:contract:check && pnpm registry:consistency:check && pnpm control-plane:coherence:check",
    "platform:vs-app:check": "tsx scripts/platform-vs-app-check.ts",
    "arch:seed": "tsx scripts/seed-architecture-demo.ts",
    "governance:snapshot": "tsx scripts/governance-snapshot.ts",
    "env:health": "tsx scripts/environment-health.ts",
    "staging:seed": "tsx scripts/staging-seed.ts",
    "rollback": "tsx scripts/rollback.ts",
    "change:validate": "tsx scripts/validate-change-window.ts",
    "change:seed-demo": "tsx scripts/change-seed-demo.ts",
    "decision:seed-demo": "tsx scripts/decision-seed-demo.ts",
    "validate:pack": "tsx scripts/validate-procurement-pack.ts",
    "validate:packages": "tsx packages/platform-validation/src/package-audit.ts",
    "validate:architecture": "tsx packages/platform-validation/src/architecture-audit.ts",
    "validate:claims": "tsx packages/platform-validation/src/claim-verification.ts",
    "validate:docs": "tsx packages/platform-validation/src/doc-consistency.ts",
    "validate:all": "tsx packages/platform-validation/src/run-all.ts",
    "validate:runtime": "tsx scripts/validate-runtime.ts",
    "validate:portfolio": "tsx scripts/validate-portfolio.ts",
    "validate:readmes": "tsx scripts/validate-readmes.ts",
    "validate:release:strict": "tsx scripts/validate-release-strict.ts",
    "validate:governance": "pnpm ga-check && pnpm contract-tests && pnpm validate:release:strict",
    "validate:governance:gate": "tsx tooling/governance/validate-governance-gate.ts",
    "validate:control:manifests": "tsx tooling/governance/validate-control-manifests.ts",
    "scaffold:app": "tsx tooling/golden-path/scaffold-governed-app.ts",
    "verify:env": "tsx tooling/build-env-check.ts",
    "verify:security": "tsx tooling/security-headers-check.ts",
    "verify:backup": "tsx scripts/backup-verify.ts",
    "generate:sbom": "tsx scripts/generate-sbom.ts",
    "attest:build": "tsx scripts/attest-build.ts",
    "reproduce:evidence": "tsx scripts/reproduce-evidence.ts",
    "health:report": "tsx scripts/platform-health-report.ts",
    "create-app": "tsx scripts/create-nzila-app.ts",
    "link-check": "tsx scripts/link-check.ts",
    "openapi:gen": "tsx tooling/openapi-gen/src/cli.ts",
    "openapi:gen:yaml": "tsx tooling/openapi-gen/src/cli.ts --format yaml",
    "build:baseline": "tsx scripts/build-baseline.ts",
    "build:baseline:save": "tsx scripts/build-baseline.ts --save",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@nzila/platform-assurance": "workspace:*",
    "@nzila/platform-change-management": "workspace:*",
    "@nzila/platform-compliance-snapshots": "workspace:*",
    "@nzila/platform-evidence-pack": "workspace:*",
    "@nzila/platform-observability": "workspace:*",
    "@nzila/platform-ops": "workspace:*",
    "@nzila/platform-performance": "workspace:*",
    "@nzila/platform-procurement-proof": "workspace:*",
    "@nzila/platform-rfp-generator": "workspace:*",
    "@nzila/platform-utils": "workspace:*",
    "@tailwindcss/oxide": "^4.2.0",
    "fast-check": "^4.6.0",
    "lefthook": "^2.1.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.19.3",
    "turbo": "^2.9.3",
    "typescript": "^6",
    "vitest": "^4.1.2",
    "yaml": "^2.8.3"
  },
  "pnpm": {
    "overrides": {
      "fastify": ">=5.8.3",
      "brace-expansion": ">=5.0.5",
      "smol-toml": ">=1.6.1",
      "yaml": ">=2.8.3",
      "tar": ">=7.5.11",
      "minimatch": ">=10.2.3",
      "node-forge": ">=1.4.0",
      "cjs-module-lexer": ">=2.2.0",
      "jspdf": ">=4.2.1",
      "@firebase/util": ">=1.10.3",
      "eslint": "^9.39.0",
      "rollup": ">=4.59.0",
      "esbuild": ">=0.25.0",
      "immutable": ">=3.8.3",
      "flatted": ">=3.4.2",
      "undici": "^7.24.0",
      "fast-xml-parser": ">=5.5.7",
      "socket.io-parser": ">=4.2.6",
      "@vitejs/plugin-react": "^4.7.0",
      "@tootallnate/once": ">=3.0.1",
      "picomatch": ">=4.0.4",
      "@xmldom/xmldom": ">=0.8.12",
      "lodash": ">=4.18.0",
      "vite": ">=7.3.2",
      "drizzle-orm": ">=0.45.2"
    }
  },
  "dependencies": {}
}
