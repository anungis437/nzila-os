{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nzila Platform Envelope Config",
  "type": "object",
  "required": ["schema_version", "tier_label_map", "products"],
  "properties": {
    "schema_version": { "type": "string" },
    "description": { "type": "string" },
    "tier_label_map": {
      "type": "object",
      "additionalProperties": { "enum": ["flagship", "growth", "component", "lab", "sunset"] }
    },
    "products": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["pricingTier", "telemetryRequired", "finopsEnabled", "trustProfile", "launchStage", "publicVisible"],
        "properties": {
          "pricingTier": { "enum": ["enterprise", "growth", "consumer", "n/a"] },
          "telemetryRequired": { "type": "boolean" },
          "finopsEnabled": { "type": "boolean" },
          "trustProfile": { "type": "string" },
          "launchStage": { "type": "string" },
          "publicVisible": { "type": "boolean" }
        }
      }
    }
  }
}
