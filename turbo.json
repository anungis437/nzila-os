{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "packages/config/**",
    "packages/**/eslint*.mjs"
  ],
  "globalPassThroughEnv": [
    "USERNAME",
    "COMPUTERNAME",
    "OS",
    "USERPROFILE",
    "APPDATA",
    "LOCALAPPDATA",
    "TEMP",
    "TMP",
    "HOMEPATH",
    "HOME",
    "USER",
    "LOGNAME",
    "SHELL",
    "TERM"
  ],
  "ui": "stream",
  "concurrency": "50%",
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**/*.json",
        "$TURBO_ROOT$/governance/**/*.json",
        "src/**",
        "app/**",
        "components/**",
        "lib/**",
        "public/**",
        "package.json",
        "tsconfig.json",
        "next.config.*",
        "tailwind.config.*",
        "postcss.config.*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "AZURE_AD_CLIENT_ID",
        "AZURE_AD_TENANT_ID",
        "NEXT_PUBLIC_WEB_URL",
        "NEXT_PUBLIC_CONSOLE_URL",
        "NEXT_PUBLIC_PARTNERS_URL",
        "NEXT_PUBLIC_UNION_EYES_URL",
        "NEXT_PUBLIC_ABR_URL",
        "NEXT_PUBLIC_CFO_URL",
        "NEXT_PUBLIC_APP_URL",
        "AUTH_SECRET",
        "NODE_ENV",
        "NEXT_PUBLIC_WEEKONE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.*",
        "src/**",
        "app/**",
        "components/**",
        "lib/**",
        "*.config.*",
        "package.json",
        "tsconfig.json"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/docs/**/*.json",
        "$TURBO_ROOT$/governance/**/*.json",
        "$TURBO_ROOT$/scripts/**/*.ts",
        "$TURBO_ROOT$/scripts/**/*.mjs",
        "$TURBO_ROOT$/tooling/**/*.ts",
        "$TURBO_ROOT$/tooling/**/*.mjs",
        "!$TURBO_ROOT$/scripts/**/*.test.ts",
        "!$TURBO_ROOT$/tooling/**/*.test.ts",
        "src/**",
        "app/**",
        "components/**",
        "lib/**",
        "package.json",
        "tsconfig.json"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "app/**",
        "lib/**",
        "services/**",
        "__tests__/**",
        "*.test.*",
        "*.spec.*",
        "package.json",
        "tsconfig.json",
        "vitest.config.*"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "clean": {
      "cache": false
    }
  },
  "cacheDir": ".turbo/cache"
}
