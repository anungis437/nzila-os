# ============================================================
# Nzila OS — Monorepo .gitignore
# ============================================================

# ----- Legacy / archived (kept out of version control) ------
legacy/
legacy-codebases/
notion_export/
*.zip

# ----- Staging / seed / ad-hoc SQL & CSV at repo root ------
staging-*.sql
staging-*.csv
staging-*.txt
seed-*.sql
temp-staging-*.sql
/audit-*.sql
/audit-*.json

# ----- Ad-hoc debug / output files at root (never commit) ------
/ue-*.txt
/pytest-*.txt
/vitest-output.txt
/test-output.txt
/test-failures.txt
/ci-failure-log.txt
/email-otp.json
/coverage.xml

# ----- Scratch / temp / exploratory files at repo root ------
/*.tmp
/*.log
/tmp-*
/ct-output.txt
/contract-test-results.txt
/ts-errors*.txt
/*-empty*.txt
/*-cols*.txt
/*-fks*.txt
/*-columns*.txt
/all-*.txt
/core-*.txt
/enum-*.txt
/fk-*.txt
/schema-*.txt
/table-*.txt
/uncovered-*.txt
/remaining-*.txt
/count-*.sql

# ----- Node / JS / TS ------
**/node_modules/
**/.next/
**/.turbo/
**/.vercel/
**/out/
**/build/
**/dist/

# ----- Proof artifacts (generated) ------
proof-artifacts/

# ----- pnpm ------
.pnpm-store/
.pnpm-cache/

# ----- Python ------
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments (root-level only — /env/ prevents matching tooling/env/)
/venv/
/env/
/ENV/
.venv

# ----- IDE ------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
**/.DS_Store

# ----- Logs ------
**/*.log

# ----- AI Eval artifacts (CI-generated, not committed) ------
tooling/ai-evals/report.json

# ----- Django (legacy) ------
local_settings.py
db.sqlite3
db.sqlite3-journal
/media
/staticfiles
/static

# ----- Environment variables ------
.env
.env.local
.env.*.local
**/.env*.local

# ----- Jupyter ------
.ipynb_checkpoints

# ----- Testing / Coverage ------
**/.coverage
**/coverage/
**/coverage_html/
**/.pytest_cache/
**/htmlcov/
**/.tox/
**/.mypy_cache/
**/coverage.xml

# ----- Database ------
*.db
*.sqlite
*.sqlite3

# ----- Secrets ------
secrets/
# Allow os-core secrets module (TypeScript source, NOT actual credentials)
!packages/os-core/src/secrets/
# Allow @nzila/secrets package (TypeScript source, NOT actual credentials)
!packages/secrets/
!packages/secrets/**
packages/secrets/node_modules/
packages/secrets/.turbo/
*.pem
*.key

# ----- Misplaced pnpm store (Windows exFAT artefact) ------
CAPPSnzila-automation.pnpm-store/

# ----- Nested package duplication (generated data in wrong path) ------
packages/packages/

# ----- Playwright ------
**/playwright-report/
**/test-results/

# ----- Security scan artifacts ------
audit-report.json
snyk-report.*
snyk-results.*
snyk-*.txt

# ----- Temporary files ------
*.tmp
*.bak
*.cache
tmp-*
.tmp-*
.pilot-check/
docker-build.log
build-output.txt
build-output.log
install-err.txt
install-log.txt
install-out.txt
tsc-output.txt
