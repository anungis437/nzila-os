# Nzila OS — UE Pilot CUPE Environment Flags
# Controlled-access pilot for CUPE Local 123 (1-3 internal users).
# Secrets must NOT be stored here — use KeyVault nzila-staging-kv.

ENVIRONMENT=PILOT
PILOT_NAME=ue-pilot-cupe
PILOT_ORG_ID=cupe-local-123
PILOT_ORG_SLUG=cupe-local-123
ALLOW_DEBUG_LOGGING=false
ALLOW_AI_EXPERIMENTAL=false
