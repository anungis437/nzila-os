# Nzila OS — Production Environment
# Customer-facing deployment. All safety features enabled.
# Secrets must NOT be stored here — use CI secrets manager.

ENVIRONMENT=PRODUCTION
ALLOW_DEBUG_LOGGING=false
ALLOW_AI_EXPERIMENTAL=false

# Azure region — Canada Central is the ONLY approved region for production
# PIPEDA / Québec Law 25: all PII must remain in Canada.
# eastus is NOT permitted for UE/CUPE or any regulated workload.
AZURE_REGION=canadacentral
NEXT_PUBLIC_REGION=canadacentral
DATA_RESIDENCY_REGION=canadacentral
DATA_RESIDENCY_COUNTRY=CA

# Azure resource targeting
AZURE_RESOURCE_GROUP=nzila-canada-prod-rg
AZURE_CONTAINERAPPS_ENVIRONMENT=nzila-canada-prod-env
